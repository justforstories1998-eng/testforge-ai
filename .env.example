# Copy to .env and fill in your values. .env is gitignored — never commit real keys.
GROQ_API_KEY=gsk_your_key_here
# Default model for generation, status checks, and chat. Must be in the
# registry (server/services/groqService.js): openai/gpt-oss-120b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b
PORT=5000
NODE_ENV=development
REACT_APP_API_URL=http://localhost:5000/api
